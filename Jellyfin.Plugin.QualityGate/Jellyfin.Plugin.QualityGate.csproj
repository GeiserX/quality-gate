<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Jellyfin.Plugin.QualityGate</RootNamespace>
    <AssemblyName>Jellyfin.Plugin.QualityGate</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <AssemblyVersion>3.9.0.1</AssemblyVersion>
    <FileVersion>3.9.0.1</FileVersion>
    <Version>3.9.0.1</Version>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Jellyfin.Plugin.QualityGate.Tests" />
  </ItemGroup>

  <!--
    Dead files that git removed long ago but that still sit in some working copies.
    They do not compile, and QualityGateController would remount the removed API by
    assembly scanning if it did. Listed one by one rather than as a directory glob so a
    future file in the same folder is not silently dropped from the build.
    Delete the files and this group can go.
  -->
  <ItemGroup>
    <Compile Remove="Api/MediaSourceFilterMiddleware.cs" />
    <Compile Remove="Api/QualityGateController.cs" />
    <Compile Remove="Api/QualityGateMiddleware.cs" />
    <Compile Remove="Api/QualityGateStartupFilter.cs" />
    <Compile Remove="Middleware/QualityGateMiddleware.cs" />
    <Compile Remove="Startup/QualityGateStartupFilter.cs" />
    <Compile Remove="PluginServiceRegistrar.cs" />
    <Compile Remove="QualityGateEntryPoint.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Jellyfin.Common" Version="12.0.0-rc5" />
    <PackageReference Include="Jellyfin.Controller" Version="12.0.0-rc5" />
    <PackageReference Include="Jellyfin.Model" Version="12.0.0-rc5" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Configuration\configPage.html" />
    <EmbeddedResource Include="Configuration\configPage.js" />
  </ItemGroup>

  <ItemGroup>
    <None Update="build.yaml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Jellyfin.Plugin.QualityGate.Tests" />
  </ItemGroup>

</Project>